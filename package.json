{
  "name": "open-smart-buttons",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Local macOS editor and USB controller for Stream Deck devices.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmyhzhang/open-smart-buttons.git"
  },
  "homepage": "https://github.com/jimmyhzhang/open-smart-buttons#readme",
  "bugs": {
    "url": "https://github.com/jimmyhzhang/open-smart-buttons/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "npm run build:ui && node src/server/main.ts",
    "dev": "node --watch-path=src src/server/main.ts --dev",
    "dev:ui": "vite --config ui/vite.config.ts",
    "sim": "npm run build:ui && node src/server/main.ts --sim --no-hid",
    "build:ui": "vite build --config ui/vite.config.ts",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test test/e2e/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "probe": "node src/tools/probe.ts",
    "doctor": "node src/tools/doctor.ts",
    "verify": "npm run typecheck && npm test && npm run test:e2e && npm run build:ui",
    "export:source": "node src/tools/export-source.ts",
    "recover": "node src/tools/recover-data.ts",
    "app:dev": "npm run build:ui && electron .",
    "app:build": "node scripts/build-electron.mjs",
    "app:dmg": "node scripts/build-electron.mjs --dmg",
    "app:dist": "node scripts/build-electron.mjs --dist",
    "app:check": "node scripts/check-app.mjs",
    "test:app": "node --test --test-concurrency=1 test/electron/*.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "electron-updater": "6.8.11",
    "lucide-static": "1.57.0",
    "ws": "8.22.0"
  },
  "optionalDependencies": {
    "node-hid": "3.4.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "playwright-core": "1.65.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "files": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test/e2e/mock-inference.mjs",
    "ui/index.html",
    "ui/tsconfig.json",
    "ui/vite.config.ts",
    "ui/src/**/*.tsx",
    "ui/src/**/*.ts",
    "ui/src/**/*.css",
    "tsconfig.json",
    "run.command",
    "docs/CONTRIBUTING.md",
    "docs/RELEASE.md",
    ".github/workflows/verify.yml",
    "scripts/verify-offline.sh",
    "LICENSE*",
    "THIRD_PARTY_NOTICES*",
    "electron/**/*.ts",
    "electron/*.cjs",
    "electron/status.html",
    "electron/status.js",
    "electron/status.css",
    "electron-builder.config.mjs",
    "build/entitlements.mac.plist",
    "build/entitlements.adhoc.mac.plist",
    "scripts/build-electron.mjs",
    "scripts/check-app.mjs",
    "scripts/make-icons.mjs",
    "test/electron/*.ts",
    "scripts/merge-latest-mac.mjs",
    "docs/DESKTOP.md",
    "CHANGELOG.md",
    "scripts/sign-app.mjs",
    "scripts/native-notices.mjs",
    "SECURITY.md"
  ],
  "main": "electron/main.ts",
  "author": "Reading Plus AI LLC"
}
